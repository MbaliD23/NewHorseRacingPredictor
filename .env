APP_NAME=HorseRacingPredictor
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me
DATABASE_URL=sqlite+aiosqlite:///./horseracingpredictor.db
SYNC_DATABASE_URL=sqlite:///./horseracingpredictor.db
WEBSITE_URL=https://legacy.winningform.co.za
SCRAPE_INTERVAL_SECONDS=10800
REQUEST_TIMEOUT_SECONDS=30
LOG_LEVEL=INFO
DEFAULT_VARIABLES=trainer_ranking,jockey_rating,starting_price
ALLOWED_ORIGINS=*
TRAINER_WEIGHT=1.0
JOCKEY_WEIGHT=1.0
DRAW_WEIGHT=1.0
WEIGHT_WEIGHT=1.0
STARTING_PRICE_WEIGHT=1.0
PREVIOUS_RUN_WEIGHT=1.0
VERIFY_SSL=false